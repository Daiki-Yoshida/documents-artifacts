diff --git a/scripts/work-runtime.js b/scripts/work-runtime.js
new file mode 100644
index 0000000..9faa5b4
--- /dev/null
+++ b/scripts/work-runtime.js
@@ -0,0 +1,54 @@
+'use strict';
+
+// Work runtime resolver CLI. Single resolution path shared by every Work
+// runtime lifecycle command (up/status/config/run/down/cleanup): it turns
+// a confirmed Work identity into the environment a docker compose
+// invocation needs, so start and teardown always resolve the same
+// resource identities.
+//
+// Runs inside the toolchain container — host Node/npm is not part of
+// this project's execution model. The host wrapper is
+// scripts/work-runtime.sh.
+//
+// Usage:
+//   node scripts/work-runtime.js env <work-type>/<work-name>
+//
+// Output: KEY=VALUE lines (safe to `export` from a POSIX shell):
+//   COMPOSE_PROJECT_NAME  Compose project/container namespace
+//   APP_HOST_PORT         Work-scoped host port
+//   DB_VOLUME_NAME        Work-scoped mutable-state volume
+//   NETWORK_NAME          Work-scoped service network
+//   PKG_CACHE_NAME        shared package/download cache volume
+
+const { workRuntime } = require('./resource-identity');
+
+function usage() {
+  console.error('usage: node scripts/work-runtime.js env <work-type>/<work-name>');
+  process.exit(2);
+}
+
+const [command, work] = process.argv.slice(2);
+
+if (command !== 'env' || !work) {
+  usage();
+}
+
+let descriptor;
+try {
+  descriptor = workRuntime(work);
+} catch (e) {
+  console.error(`work-runtime: ${e.message}`);
+  process.exit(2);
+}
+
+const env = {
+  COMPOSE_PROJECT_NAME: descriptor.composeProject,
+  APP_HOST_PORT: String(descriptor.hostPort),
+  DB_VOLUME_NAME: descriptor.dbVolume,
+  NETWORK_NAME: descriptor.network,
+  PKG_CACHE_NAME: descriptor.cacheVolume,
+};
+
+for (const [key, value] of Object.entries(env)) {
+  console.log(`${key}=${value}`);
+}
diff --git a/scripts/work-runtime.sh b/scripts/work-runtime.sh
new file mode 100755
index 0000000..4e379b6
--- /dev/null
+++ b/scripts/work-runtime.sh
@@ -0,0 +1,171 @@
+#!/bin/sh
+# Host-side wrapper for confirmed-Work runtime operations.
+#
+# A caller at the Project Root designates the target confirmed Work by
+# its Work Root directory (or its repository checkout) via DIR:
+#
+#   make DIR=.worktrees/feat/schema-preview work-up
+#   make DIR=.worktrees/feat/schema-preview work-status
+#   make DIR=.worktrees/feat/schema-preview work-config
+#   make DIR=.worktrees/feat/schema-preview work-down
+#   make DIR=.worktrees/feat/schema-preview work-cleanup
+#
+# DIR is only a path locator. This script resolves it to the Work
+# identity <work-type>/<work-name>, validates that the path is a
+# confirmed Work Root (tracked documents/ plus the Work's registered
+# `main` checkout), resolves all runtime resource identities through the
+# project-owned policy module (scripts/resource-identity.js, executed in
+# the toolchain container — host Node/npm is not required), then runs
+# the matching docker compose lifecycle command against the Work's
+# checkout. Every operation resolves the same identity, so start and
+# teardown always target the same resources.
+set -eu
+
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+REPO_SELECTOR=main
+
+fail() {
+  echo "work-runtime: $*" >&2
+  exit 1
+}
+
+usage() {
+  cat >&2 <<'EOF'
+usage: work-runtime.sh <op> <dir> [args...]
+
+  <dir>   Work Root (.worktrees/<work-type>/<work-name>) or its
+          repository checkout (.worktrees/<work-type>/<work-name>/main)
+
+  ops:
+    up        start the Work runtime alongside the default runtime
+    status    show the Work runtime's containers
+    config    render the resolved compose configuration (dry run)
+    run       run a one-off command inside the Work runtime
+              (remaining args are the command; default: the service command)
+    down      stop and remove the Work runtime's containers/network
+              (volumes are kept)
+    cleanup   down + remove the Work-scoped DB volume (destructive)
+EOF
+  exit 2
+}
+
+[ $# -ge 2 ] || usage
+OP=$1
+DIR=$2
+shift 2
+
+# --- Resolve DIR -> Work Root, checkout, and Work identity -----------
+
+case $DIR in
+  '') usage ;;
+esac
+DIR=${DIR%/}
+
+# Absolute path of the candidate (must already exist — a Work runtime
+# operates on an existing confirmed Work Root).
+[ -d "$ROOT/$DIR" ] || [ -d "$DIR" ] || fail "DIR '$DIR' does not exist"
+if [ -d "$ROOT/$DIR" ]; then
+  CANDIDATE=$(CDPATH= cd -- "$ROOT/$DIR" && pwd -P)
+else
+  CANDIDATE=$(CDPATH= cd -- "$DIR" && pwd -P)
+fi
+
+# Accept either the Work Root or its single repository checkout.
+case $CANDIDATE in
+  */"$REPO_SELECTOR")
+    WORKROOT=${CANDIDATE%/"$REPO_SELECTOR"}
+    ;;
+  *)
+    WORKROOT=$CANDIDATE
+    ;;
+esac
+CHECKOUT=$WORKROOT/$REPO_SELECTOR
+
+case $WORKROOT in
+  "$ROOT"/.worktrees/*/*) ;;
+  *) fail "DIR must resolve to a Work Root under .worktrees/<work-type>/<work-name>" ;;
+esac
+
+WORK=${WORKROOT#"$ROOT"/.worktrees/}
+case $WORK in
+  */*/* | '' | */ | *[!a-z0-9/-]* | -* | */-* | *- | *-/*)
+    fail "cannot derive a Work identity <work-type>/<work-name> from '$WORK'"
+    ;;
+esac
+
+# --- Validate the confirmed Work Root contract ------------------------
+
+[ -f "$WORKROOT/documents/WORK.md" ] ||
+  fail "'$WORK' has no tracked Work Documents ($WORKROOT/documents/WORK.md) — not a confirmed Work Root"
+[ -d "$CHECKOUT" ] && [ -e "$CHECKOUT/.git" ] ||
+  fail "'$WORK' has no repository checkout at $CHECKOUT"
+git -C "$ROOT" worktree list --porcelain | grep -qx "worktree $CHECKOUT" ||
+  fail "$CHECKOUT is not a registered worktree of this repository"
+
+# --- Resolve runtime resources via the project-owned policy module ----
+# The module runs in the shared toolchain container; host Node/npm is
+# not part of this project's execution model.
+
+IMAGE=$(docker compose -f "$ROOT/compose.yml" config --images 2>/dev/null | sed -n '1p')
+[ -n "$IMAGE" ] || fail "cannot resolve the toolchain image from compose.yml"
+
+if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
+  echo "work-runtime: building toolchain image $IMAGE" >&2
+  docker compose -f "$ROOT/compose.yml" build app >&2
+fi
+
+RESOLVED=$(docker run --rm \
+  -v "$ROOT:/project:ro" \
+  -w /project \
+  "$IMAGE" node scripts/work-runtime.js env "$WORK") ||
+  fail "could not resolve runtime resources for Work '$WORK'"
+
+for kv in $RESOLVED; do
+  case $kv in
+    COMPOSE_PROJECT_NAME=*|APP_HOST_PORT=*|DB_VOLUME_NAME=*|NETWORK_NAME=*|PKG_CACHE_NAME=*)
+      export "$kv"
+      ;;
+    *)
+      fail "unexpected resolver output '$kv'"
+      ;;
+  esac
+done
+
+# Base file: the Work's own checkout compose.yml. Override: the
+# project-owned compose.work.yml, which pins the resolved Work-scoped
+# resource identities regardless of the checkout's compose file.
+COMPOSE="docker compose -f $CHECKOUT/compose.yml -f $ROOT/compose.work.yml --project-directory $CHECKOUT"
+
+echo "work-runtime: work=$WORK project=$COMPOSE_PROJECT_NAME port=$APP_HOST_PORT db=$DB_VOLUME_NAME net=$NETWORK_NAME" >&2
+
+# --- Dispatch ----------------------------------------------------------
+
+case $OP in
+  up)
+    $COMPOSE up -d app
+    ;;
+  status)
+    $COMPOSE ps -a
+    ;;
+  config)
+    $COMPOSE config
+    ;;
+  run)
+    $COMPOSE run --rm app "$@"
+    ;;
+  down)
+    $COMPOSE down
+    ;;
+  cleanup)
+    # Work-scoped destructive operation: removes this Work runtime's
+    # mutable-state volume only. The shared image and the shared package
+    # cache volume are never touched. `compose down` is used (not
+    # `down -v`) precisely so the shared cache volume cannot be removed.
+    $COMPOSE down
+    docker volume rm "$DB_VOLUME_NAME" >/dev/null 2>&1 || true
+    echo "work-runtime: removed Work-scoped volume $DB_VOLUME_NAME" >&2
+    ;;
+  *)
+    usage
+    ;;
+esac
