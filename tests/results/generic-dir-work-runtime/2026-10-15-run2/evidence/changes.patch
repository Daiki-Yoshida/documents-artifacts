+++ b/compose.work.yml
@@ -0,0 +1,33 @@
+# Project-owned Work runtime override.
+#
+# scripts/work-runtime.sh applies this file on top of a confirmed Work's
+# checkout compose.yml, so Work-scoped runtime resources always resolve
+# to the identities derived from the confirmed Work identity — even if
+# the Work's branch carries an older or different compose.yml. Every
+# value is interpolated from the resolver's exported environment
+# (scripts/work-runtime.js env <work>); each is marked required so a
+# missing value fails loudly instead of silently falling back to the
+# default runtime's resources.
+#
+# Project-scoped resources (shared): the toolchain image and the
+# pkg-cache volume resolve to the same names as the default runtime.
+# Work-scoped resources (isolated): DB volume, host port, network.
+
+services:
+  app:
+    # Replace the service's port mapping entirely: the Work runtime may
+    # only publish its own deterministic host port.
+    ports: !override
+      - "${APP_HOST_PORT:?work-runtime: APP_HOST_PORT required}:3000"
+
+volumes:
+  # Shared package/download cache — identical name for every runtime.
+  pkg-cache:
+    name: "${PKG_CACHE_NAME:?work-runtime: PKG_CACHE_NAME required}"
+  # Work-scoped mutable state.
+  db-data:
+    name: "${DB_VOLUME_NAME:?work-runtime: DB_VOLUME_NAME required}"
+
+networks:
+  default:
+    name: "${NETWORK_NAME:?work-runtime: NETWORK_NAME required}"
