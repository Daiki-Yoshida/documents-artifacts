+# Host entry points for project runtimes. Managed runtime (Node/npm,
 # project commands) executes inside the app container; the host provides
 # Git, Docker/Compose, and Make only.
+#
+# Target selection: commands operate on the default runtime, or on one
+# confirmed Work's parallel runtime when WORK=<type>/<name> is given.
+#   make up                            # default runtime
+#   make up WORK=feat/schema-preview   # that Work's parallel runtime
 
-.PHONY: verify test resource-check up down
+WORK ?=
+
+# One scope resolution for the whole lifecycle family: with WORK set,
+# every command goes through scripts/work-compose.sh, which derives all
+# Work-scoped resources from scripts/resource-identity.js.
+ifdef WORK
+COMPOSE = scripts/work-compose.sh $(WORK)
+else
+COMPOSE = docker compose
+endif
+
+.PHONY: help up status config verify test resource-check down
+
+help:
+	@echo 'Runtime commands (default runtime, or WORK=<type>/<name>):'
+	@echo '  make up                  start the runtime'
+	@echo '  make status              show runtime containers'
+	@echo '  make config              show resolved Compose configuration'
+	@echo '  make verify              run project verification inside the runtime'
+	@echo '  make test                run app tests inside the runtime'
+	@echo '  make resource-check      validate the runtime resource policy'
+	@echo '  make down                stop the runtime (volumes are kept)'
+
+up:
+	$(COMPOSE) up -d app
+
+status:
+	$(COMPOSE) ps
+
+config:
+	$(COMPOSE) config
 
