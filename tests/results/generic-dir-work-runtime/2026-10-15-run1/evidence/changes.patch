diff --git a/scripts/runtime-env.js b/scripts/runtime-env.js
new file mode 100644
index 0000000..6754ad2
--- /dev/null
+++ b/scripts/runtime-env.js
@@ -0,0 +1,53 @@
+'use strict';
+
+// Emits the Compose environment (dotenv on stdout) for a confirmed
+// Work's parallel runtime. Runs inside the managed container — the host
+// provides no Node. scripts/work-compose.sh feeds the output to
+// `docker compose --env-file`, so every lifecycle command shares this
+// single scope resolution.
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { workRuntime } = require('./resource-identity');
+
+function fail(message) {
+  console.error(`runtime-env: ${message}`);
+  process.exit(1);
+}
+
+const work = process.argv[2];
+if (!work) {
+  fail('usage: node scripts/runtime-env.js <work-identity>');
+}
+
+let r;
+try {
+  r = workRuntime(work);
+} catch (e) {
+  fail(e.message);
+}
+
+// Only confirmed Works may materialize a runtime: the Work Root must
+// hold its tracked documents/ and its 'main' checkout of this repo.
+const root = path.join(__dirname, '..');
+const workRoot = path.join(root, '.worktrees', ...work.split('/'));
+for (const rel of ['documents', 'main']) {
+  const st = fs.statSync(path.join(workRoot, rel), { throwIfNoEntry: false });
+  if (!st || !st.isDirectory()) {
+    fail(`'${work}' is not a confirmed Work: missing .worktrees/${work}/${rel}/`);
+  }
+}
+
+const env = {
+  COMPOSE_PROJECT_NAME: r.project,
+  APP_IMAGE: r.image,
+  APP_SOURCE: r.sourceDir,
+  APP_HOST_PORT: r.hostPort,
+  PKG_CACHE_VOLUME: r.cacheVolume,
+  DB_VOLUME: r.dbVolume,
+  NETWORK: r.network,
+};
+
+for (const [key, value] of Object.entries(env)) {
+  console.log(`${key}=${value}`);
+}
diff --git a/scripts/work-compose.sh b/scripts/work-compose.sh
new file mode 100755
index 0000000..0760ba2
--- /dev/null
+++ b/scripts/work-compose.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Compose wrapper scoped to a confirmed Work's parallel runtime.
+#
+#   scripts/work-compose.sh <work-identity> <docker compose args...>
+#
+# Resolves the Work-scoped environment through the project-owned
+# resource policy (scripts/runtime-env.js, executed in the managed
+# container — the host provides no Node) and forwards every compose
+# subcommand through the same --env-file, so up/status/config/verify/
+# down all resolve identical resources for a given Work.
+set -eu
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: $0 <work-identity> <docker compose args...>" >&2
+  exit 2
+fi
+work=$1
+shift
+
+# Resolve from the Project Root regardless of the caller's cwd.
+cd "$(dirname "$0")/.."
+
+env_file=$(mktemp "${TMPDIR:-/tmp}/work-runtime-env.XXXXXX")
+trap 'rm -f "$env_file"' EXIT
+
+docker compose run --rm -T app node scripts/runtime-env.js "$work" > "$env_file"
+
+exec docker compose --env-file "$env_file" "$@"
