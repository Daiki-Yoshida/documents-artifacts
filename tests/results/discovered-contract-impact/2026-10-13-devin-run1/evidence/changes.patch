diff --git a/src/internal/preview.sh b/src/internal/preview.sh
index 9abc6fe..1ea4c90 100644
--- a/src/internal/preview.sh
+++ b/src/internal/preview.sh
@@ -1,8 +1,18 @@
 #!/usr/bin/env bash
 source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/shared/name.sh"
 
+# Extended globs enable the space-run collapsing below.
+shopt -s extglob
+
 preview_contact() {
   local raw_name="$1"
-  # Current defect: the staff display repeats imported whitespace.
-  printf 'Name: %s\n' "$(contact_name "$raw_name")"
+  local display_name
+  display_name="$(contact_name "$raw_name")"
+  # Staff display normalization (presentation only): squeeze each run of
+  # ASCII spaces to one space, then drop the remaining edge space. The raw
+  # imported value used by the published export is left untouched.
+  display_name="${display_name//+( )/ }"
+  display_name="${display_name# }"
+  display_name="${display_name% }"
+  printf 'Name: %s\n' "$display_name"
 }
