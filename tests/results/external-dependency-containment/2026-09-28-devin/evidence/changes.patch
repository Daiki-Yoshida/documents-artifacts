@@ -0,0 +1,18 @@
+'use strict';
+
+// Infrastructure edge: the only project-owned module that talks to the
+// Acme SDK. Translates the vendor v2 representation into the project's
+// profile shape — vendor vocabulary does not cross this boundary.
+
+const acme = require('../../vendor/acme-sdk');
+
+async function fetchProfile(userId) {
+  const raw = await acme.fetchUser(userId);
+  return {
+    id: raw.user_id,
+    displayName: raw.profile.display_name,
+    email: raw.contacts.primary_email,
+  };
+}
+
+module.exports = { fetchProfile };
